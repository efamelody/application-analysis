{
  "manifest_version": 3,
  "name": "JobTracker Scraper",
  "version": "1.0.0",
  "description": "1-click save JobStreet listings to your Application Tracker with Gap Analysis.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.jobstreet.com/*", "https://*.jobstreet.com.my/*", "https://*.jobstreet.com.sg/*", "https://*.jobstreet.co.id/*"],
  "action": {
    "default_title": "Track Application"
  },
  "background": {
    "service_worker": "background.js"
  }
}
